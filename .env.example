# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=seu_token_telegram_aqui
TELEGRAM_USER_ID=seu_telegram_user_id_aqui  # Ex: 58159760 (Seu ID numérico para acesso exclusivo)
TELEGRAM_WEBHOOK_SECRET=

# ── Azure Blob Storage (Hospedagem das Imagens para a Meta API) ─
AZURE_STORAGE_CONNECTION_STRING=sua_connection_string_aqui
AZURE_STORAGE_CONTAINER_NAME=passageiro100milhasbot

# ── Meta Graph API (Instagram & Facebook) ───────────────────
# Aceita tanto META_ACCESS_TOKEN quanto FB_PAGE_ACCESS_TOKEN
META_ACCESS_TOKEN=seu_token_meta_aqui
INSTAGRAM_ACCOUNT_ID=seu_instagram_account_id_aqui

# ── IA & Visão Computacional (Google Gemini Oficial) ────────
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey (ex: AIzaSy... ou AQ...)
GEMINI_API_KEY=sua_chave_gemini_aqui

# ── Configurações de Execução ───────────────────────────────
PORT=8000
ENVIRONMENT=development
